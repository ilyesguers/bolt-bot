# ============================================
# eFootball Traffic Analyzer - Environment
# انسخ هذا الملف إلى .env للتشغيل المحلي
# Railway يقرأ من Variables وليس من هذا الملف
# ============================================

# المنفذ - Railway يضبطه تلقائياً (لا تغيره هناك)
# محلياً: 8080
PORT=8080

# عدد السجلات المحفوظة في الذاكرة (الأحدث أولاً)
LOG_LIMIT=500

# فلتر: true = يعرض فقط eFootball (*.konami.net) - موصى به
# false = يعرض كل الترافيك (يستهلك RAM ويكشف خصوصيتك)
EFOOTBALL_ONLY=true

# ملاحظة: لا تحتاج شهادة Mitmproxy في وضع TUNNEL الحالي
# المستقبل (MITM): ستحتاج mitmproxy-ca-cert.pem
